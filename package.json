{
  "name": "homesense-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run -w backend dev",
    "dev:frontend": "npm run -w frontend dev",
    "build": "npm run -w backend build && npm run -w frontend build",
    "build:backend": "npm run -w backend build",
    "build:frontend": "npm run -w frontend build",
    "db:init": "npm run -w backend db:init",
    "check:encoding": "node scripts/check-mojibake.mjs",
    "check:manifests": "node scripts/check-manifest-projections.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
