{
  "name": "bilibili-cli",
  "executable": "../../packages/bilibili-cli/src/index.mjs",
  "protocol": "in_process_module",
  "cwd": ".",
  "args": [],
  "timeout_ms": 30000,
  "actions": {
    "health": {
      "description": "Check the local Bilibili CLI dry-run runtime.",
      "params_schema": {}
    },
    "prepare_upload": {
      "description": "Create a local Bilibili upload draft with metadata and preflight checks.",
      "params_schema": {
        "title": "string",
        "source_path": "string?",
        "description": "string?",
        "tags": "string[]?",
        "cover_path": "string?",
        "tid": "number?",
        "copyright": "string?",
        "visibility": "string?",
        "dry_run": "boolean?"
      }
    },
    "set_metadata": {
      "description": "Update metadata on an existing local Bilibili upload draft.",
      "params_schema": {
        "draft_id": "string",
        "title": "string?",
        "description": "string?",
        "tags": "string[]?",
        "tid": "number?",
        "copyright": "string?",
        "visibility": "string?"
      }
    },
    "list_drafts": {
      "description": "List local Bilibili upload drafts.",
      "params_schema": {
        "status": "string?"
      }
    },
    "submit_upload": {
      "description": "Validate and stage an upload draft; real submission requires credentials and is disabled by default.",
      "params_schema": {
        "draft_id": "string",
        "dry_run": "boolean?"
      }
    }
  }
}
